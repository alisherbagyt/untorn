# Copy this file to .env and edit as needed.
# When running with Docker Compose, these are set in docker-compose.yml directly.

# Device for PyTorch models: "cuda" (NVIDIA GPU) or "cpu"
TORCH_DEVICE=cuda

# Path to the LaMa TorchScript JIT model (inside the container or on host)
LAMA_JIT_PATH=lama/big-lama/big-lama.pt

# URL the Next.js server uses to reach the backend API.
# Inside Docker Compose: http://backend:8000
# Running locally without Docker: http://localhost:8000
BACKEND_URL=http://localhost:8000
